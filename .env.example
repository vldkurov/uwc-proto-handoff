# Local development only. Generate your own DJANGO_SECRET_KEY before starting.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-new-local-secret
DJANGO_ADMIN_PATH=admin
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://localhost:5432/uwc_local
USE_S3=False

# Placeholders allow normal pages to run without access to the old AWS account.
AWS_SES_ACCESS_KEY_ID=local-development-disabled
AWS_SES_SECRET_ACCESS_KEY=local-development-disabled
AWS_SES_REGION_NAME=eu-west-2
AWS_S3_ACCESS_KEY_ID=local-development-disabled
AWS_S3_SECRET_ACCESS_KEY=local-development-disabled
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-2
DEFAULT_FROM_EMAIL=developer@example.invalid

# Obtain your own keys when enabling these integrations.
GOOGLE_MAPS_API_KEY=local-development-disabled
PAYPAL_CLIENT_ID=local-development-disabled
PAYPAL_CLIENT_SECRET=local-development-disabled
PAYPAL_MODE=sandbox

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
