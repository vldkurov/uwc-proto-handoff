#: templates/account/email/base_message.txt:1
#, python-format
msgid "Hello from %(site_name)s!"
msgstr "Привіт від %(site_name)s!"

#: templates/account/email/base_message.txt:5
#, python-format
msgid ""
"Thank you for using %(site_name)s!\n"
"%(site_domain)s"
msgstr ""
"Дякуємо, що користуєтеся %(site_name)s!\n"
"%(site_domain)s"

#: templates/account/email/email_confirmation_message.txt:5
#, python-format
msgid ""
"You're receiving this email because user %(user_display)s has given your "
"email address to register an account on %(site_domain)s."
msgstr ""
"Ви отримали цей лист, тому що користувач %(user_display)s вказав вашу "
"електронну адресу для реєстрації облікового запису на %(site_domain)s."

#: templates/account/email/email_confirmation_message.txt:7
msgid ""
"Your email verification code is listed below. Please enter it in your open "
"browser window."
msgstr ""
"Ваш код підтвердження електронної пошти наведений нижче. Будь ласка, введіть "
"його у відкритому вікні браузера."

#: templates/account/email/email_confirmation_message.txt:9
#, python-format
msgid "To confirm this is correct, go to %(activate_url)s"
msgstr ""
"Щоб підтвердити, що це правильно, перейдіть за посиланням %(activate_url)s"

#: templates/account/email/email_confirmation_subject.txt:3
msgid "Please Confirm Your Email Address"
msgstr "Будь ласка, підтвердьте свою електронну адресу"

#: templates/account/email_confirm.html:6
#: templates/account/email_confirm.html:10
msgid "Confirm Email Address"
msgstr "Підтвердити електронну адресу"

#: templates/account/email_confirm.html:16
#, python-format
msgid ""
"Please confirm that <a href=\"mailto:%(email)s\">%(email)s</a> is an email "
"address for user %(user_display)s."
msgstr ""
"Будь ласка, підтвердіть, що %(email)s є електронною адресою користувача "
"%(user_display)s."

#: templates/account/email_confirm.html:28
#, python-format
msgid ""
"Unable to confirm %(email)s because it is already confirmed by a different "
"account."
msgstr ""
"Неможливо підтвердити %(email)s, оскільки вона вже підтверджена іншим "
"обліковим записом."

#: templates/account/email_confirm.html:34
#, python-format
msgid ""
"This email confirmation link expired or is invalid. Please <a "
"href=\"%(email_url)s\">issue a new email confirmation request</a>."
msgstr ""
"Цей посилання для підтвердження електронної пошти минув або є недійсним. "
"Будь ласка, надішліть <a href=\"%(email_url)s\"> новий запит на "
"підтвердження електронної пошти."

